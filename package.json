{
  "name": "indra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --import tsx --watch src/cli.ts",
