{
  "type": "object",
  "additionalProperties": false,
  "required": ["observations", "ownerProposals"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "text"],
        "properties": {
          "evidenceId": { "type": "string" },
          "kind": { "type": "string", "enum": ["went-well", "went-poorly"] },
          "text": { "type": "string" }
        }
      }
    },
    "ownerProposals": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "text"],
        "properties": {
          "evidenceId": { "type": "string" },
          "kind": { "type": "string", "enum": ["owner-proposal"] },
          "text": { "type": "string" }
        }
      }
    }
  }
}
