{
  "type": "object",
  "additionalProperties": false,
  "required": ["observations", "phaseReflections", "ownerProposals"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "text"],
        "properties": {
          "evidenceId": { "type": "string" },
          "kind": { "type": "string", "enum": ["went-well", "went-poorly"] },
          "text": { "type": "string" }
        }
      }
    },
    "phaseReflections": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "evidenceId", "kind", "text"],
        "properties": {
          "phase": { "type": "string", "enum": ["planning", "proposal", "implement", "release", "retro"] },
          "evidenceId": { "type": "string" },
          "kind": { "type": "string", "enum": ["worked", "slowed", "noted", "unknown"] },
          "text": { "type": "string" }
        }
      }
    },
    "ownerProposals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "kind", "text", "phase"],
        "properties": {
          "evidenceId": { "type": "string" },
          "kind": { "type": "string", "enum": ["owner-proposal"] },
          "text": { "type": "string" },
          "phase": { "anyOf": [{ "type": "string", "enum": ["planning", "proposal", "implement", "release", "retro"] }, { "type": "null" }] }
        }
      }
    }
  }
}
