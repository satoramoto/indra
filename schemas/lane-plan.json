{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "goalId",
    "lanes",
    "contractLaneId"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "goalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "branch",
          "ownedFiles",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "branch": {
            "type": "string",
            "pattern": "\\S"
          },
          "ownedFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    },
    "contractLaneId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
