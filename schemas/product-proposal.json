{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "goalId",
    "proposalId",
    "productSeatId",
    "rank",
    "mission",
    "summary",
    "outcomes",
    "ownedFiles",
    "risks",
    "rationale",
    "basedOnRetros"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "goalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "productSeatId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "mission": {
      "type": "string",
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "pattern": "\\S"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "description",
          "reason",
          "currentCode"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "currentCode": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      },
      "minItems": 1
    },
    "ownedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "rationale": {
      "type": "string",
      "pattern": "\\S"
    },
    "basedOnRetros": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
