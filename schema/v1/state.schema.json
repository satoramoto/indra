{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/satoramoto/indra-state/blob/main/schema/v1/state.schema.json",
  "title": "Indra state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "teams"],
  "properties": {
    "$schema": { "const": "./schema/v1/state.schema.json" },
    "schemaVersion": { "const": 1 },
    "teams": {
      "type": "array",
      "items": { "$ref": "#/$defs/team" }
    },
    "sprints": {
      "description": "Retired draft sprints from before planning goals. Ignored by Indra, which empties it at start-up; kept as [] because older builds require it.",
      "deprecated": true,
      "type": "array"
    },
    "planningGoals": {
      "type": "array",
      "items": { "$ref": "#/$defs/planningGoal" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "mattermostTeam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teamId"],
      "properties": {
        "teamId": { "$ref": "#/$defs/nonEmptyText" },
        "homeChannelId": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^(?!\\.\\.?/)[A-Za-z0-9_.-]+/(?!\\.\\.?$)[A-Za-z0-9_.-]+$"
        }
      }
    },
    "mattermostSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username"],
      "properties": {
        "userId": { "$ref": "#/$defs/nonEmptyText" },
        "username": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "displayName", "externalIdentities", "seats"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyText" },
        "project": { "$ref": "#/$defs/project" },
        "mission": {"type":"string","pattern":"\\S"},
        "standingPolicy": {"$ref":"#/$defs/standingPolicy"},
        "backlog": {"type":"array","items":{"$ref":"#/$defs/backlogTicket"}},
        "sprintCandidates": {"type":"array","items":{"$ref":"#/$defs/sprintCandidate"}},
        "externalIdentities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mattermost"],
          "properties": {
            "mattermost": { "$ref": "#/$defs/mattermostTeam" }
          }
        },
        "seats": {
          "type": "array",
          "items": { "$ref": "#/$defs/seat" }
        }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "roles", "externalIdentities"],
      "allOf": [{"if":{"required":["status"],"properties":{"status":{"enum":["pending","retired"]}}},"else":{"properties":{"externalIdentities":{"properties":{"mattermost":{"required":["userId"]}}}}}}],
      "properties": {
        "status": {"enum":["pending","active","retiring","retired"],"default":"active"},
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/nonEmptyText" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "enum": ["Team Lead", "Developer", "Product"] }
        },
        "externalIdentities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mattermost"],
          "properties": {
            "mattermost": { "$ref": "#/$defs/mattermostSeat" }
          }
        }
      }
    },
    "planningGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "teamId", "seatId", "participantSeatIds", "goal", "projectRefs", "stage", "createdAt", "updatedAt", "mattermost", "brief"],
      "allOf": [{
        "if": { "properties": { "stage": { "enum": ["awaiting-review", "approved"] } }, "required": ["stage"] },
        "then": { "required": ["proposal"] },
        "else": { "not": { "required": ["proposal"] } }
      }, {
        "if": { "properties": { "stage": { "const": "approved" } }, "required": ["stage"] },
        "else": { "not": { "anyOf": [{ "required": ["assignments"] }, { "required": ["integration"] }] } }
      }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "teamId": { "$ref": "#/$defs/id" },
        "seatId": { "$ref": "#/$defs/id" },
        "participantSeatIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "goal": { "$ref": "#/$defs/nonEmptyText" },
        "projectRefs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } },
        "stage": { "enum": ["clarifying", "drafting", "awaiting-review", "approved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "mattermost": {
          "type": "object", "additionalProperties": false, "required": ["channelId", "rootPostId"],
          "properties": {
            "channelId": { "$ref": "#/$defs/nonEmptyText" },
            "rootPostId": { "$ref": "#/$defs/nonEmptyText" }
          }
        },
        "brief": {
          "type": "object", "additionalProperties": false, "required": ["summary", "decisions", "openQuestions"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyText" },
            "decisions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } },
            "openQuestions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } }
          }
        },
        "proposal": { "$ref": "#/$defs/planningProposal" },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/planningAssignment" } },
        "integration": { "$ref": "#/$defs/sprintIntegration" },
        "ceremony": { "$ref": "#/$defs/ceremony" },
        "source": {"type":"object","additionalProperties":false,"required":["candidateId","ticketIds"],"properties":{"candidateId":{"$ref":"#/$defs/id"},"ticketIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"retrospectiveGoalId":{"$ref":"#/$defs/id"}}},
        "automaticApprovals": {"type":"array","items":{"$ref":"#/$defs/ceremonyAutomaticApproval"}}
      }
    },
    "sprintIntegration": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "baseSha", "status"],
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["pr-open", "merged", "reverted"] } } }, "then": { "required": ["prUrl"] } },
        { "if": { "properties": { "status": { "enum": ["merged", "reverted"] } } }, "then": { "required": ["mergedSha"] } },
        { "if": { "properties": { "status": { "const": "reverted" } } }, "then": { "required": ["revertPrUrl"] } }
      ],
      "properties": {
        "branch": { "type": "string", "pattern": "^sprint/[a-z][a-z0-9-]+$" },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "status": { "enum": ["collecting", "pr-open", "merged", "reverted"] },
        "prUrl": { "$ref": "#/$defs/nonEmptyText" },
        "mergedSha": { "$ref": "#/$defs/gitSha" },
        "revertPrUrl": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "planningAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["outcomeId", "seatId", "status", "updatedAt"],
      "properties": {
        "outcomeId": { "$ref": "#/$defs/id" },
        "seatId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["queued", "running", "in-review", "merged", "failed"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "prUrl": { "$ref": "#/$defs/nonEmptyText" },
        "note": { "$ref": "#/$defs/nonEmptyText" },
        "reassignments": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["fromSeatId","toSeatId","at","reason"],"properties":{"fromSeatId":{"$ref":"#/$defs/id"},"toSeatId":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/ceremonyTime"},"reason":{"$ref":"#/$defs/ceremonyText"}}}}
      }
    },
    "planningProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "createdAt", "summary", "outcomes", "risks", "openQuestions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" },
        "summary": { "$ref": "#/$defs/nonEmptyText" },
        "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/planningOutcome" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } },
        "openQuestions": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } }
      }
    },
    "planningOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "seatId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "seatId": { "$ref": "#/$defs/id" }
      }
    },
    "ceremonyText": {"type": "string", "pattern": "\\S"},
    "ceremonyTime": {"type": "string", "format": "date-time"},
    "ceremonySha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ceremonyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "ceremonyPr": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"},
    "ceremonyHumanApproval": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source", "command", "at"], "properties": {"source": {"const": "owner-command"}, "command": {"enum": ["planning approve", "planning merge"]}, "at": {"$ref": "#/$defs/ceremonyTime"}}}, {"type": "object", "additionalProperties": false, "required": ["source", "userId", "postId", "emoji", "verifiedHuman", "at"], "properties": {"source": {"const": "reaction"}, "userId": {"$ref": "#/$defs/ceremonyText"}, "postId": {"$ref": "#/$defs/ceremonyText"}, "emoji": {"const": "white_check_mark"}, "verifiedHuman": {"const": true}, "at": {"$ref": "#/$defs/ceremonyTime"}}}]},
    "ceremonyApproval": {"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","proposalId","proposalPostId","approval"],"properties":{"kind":{"const":"approval"},"proposalId":{"$ref":"#/$defs/ceremonyId"},"proposalPostId":{"$ref":"#/$defs/ceremonyText"},"approval":{"$ref":"#/$defs/ceremonyHumanApproval"}}},{"type":"object","additionalProperties":false,"required":["kind","proposalId","proposalPostId","approval"],"properties":{"kind":{"const":"automatic-approval"},"proposalId":{"$ref":"#/$defs/ceremonyId"},"proposalPostId":{"$ref":"#/$defs/ceremonyText"},"approval":{"$ref":"#/$defs/ceremonyAutomaticApproval"}}}]},
    "ceremonyImplementation": {"type": "object", "additionalProperties": false, "required": ["kind", "outcomes"], "properties": {"kind": {"const": "implementation"}, "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["outcomeId", "seatId", "prUrl", "baseBranch", "mergedSha", "checksPassed", "reviewApproved"], "properties": {"outcomeId": {"$ref": "#/$defs/ceremonyId"}, "seatId": {"$ref": "#/$defs/ceremonyId"}, "prUrl": {"$ref": "#/$defs/ceremonyPr"}, "baseBranch": {"$ref": "#/$defs/ceremonyText"}, "mergedSha": {"$ref": "#/$defs/ceremonySha"}, "checksPassed": {"const": true}, "reviewApproved": {"const": true}}}}, "omissions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["outcomeId", "seatId", "reason"], "properties": {"outcomeId": {"$ref": "#/$defs/ceremonyId"}, "seatId": {"$ref": "#/$defs/ceremonyId"}, "reason": {"$ref": "#/$defs/ceremonyText"}}}}, "partialApproval": {"type": "object", "additionalProperties": false, "required": ["source", "command", "at"], "properties": {"source": {"const": "owner-command"}, "command": {"const": "planning integrate"}, "at": {"$ref": "#/$defs/ceremonyTime"}}}}, "allOf": [{"if": {"required": ["omissions"]}, "then": {"required": ["partialApproval"]}}, {"if": {"required": ["partialApproval"]}, "then": {"required": ["omissions"]}}]},
    "ceremonyRelease": {"type":"object","additionalProperties":false,"required":["kind","prUrl","mergedSha","mergePostId","approval","checksPassed","buildSha","runningSha","runningAt"],"properties":{"kind":{"const":"release-running"},"prUrl":{"$ref":"#/$defs/ceremonyPr"},"mergedSha":{"$ref":"#/$defs/ceremonySha"},"mergePostId":{"$ref":"#/$defs/ceremonyText"},"approval":{"$ref":"#/$defs/ceremonyApprovalProvenance"},"headSha":{"$ref":"#/$defs/ceremonySha"},"checksPassed":{"const":true},"buildSha":{"$ref":"#/$defs/ceremonySha"},"runningSha":{"$ref":"#/$defs/ceremonySha"},"runningAt":{"$ref":"#/$defs/ceremonyTime"},"ancestry":{"type":"object","additionalProperties":false,"required":["ancestorSha","descendantSha","verified"],"properties":{"ancestorSha":{"$ref":"#/$defs/ceremonySha"},"descendantSha":{"$ref":"#/$defs/ceremonySha"},"verified":{"const":true}}}},"allOf":[{"if":{"properties":{"approval":{"properties":{"source":{"const":"automatic"}}}}},"then":{"required":["headSha"]}}]},
    "ceremonyRetro": {"type":"object","additionalProperties":false,"required":["kind","path","prUrl","baseBranch","mergedSha","postId","publishedAt","factsOnly","suggestions"],"properties":{"kind":{"const":"retro-published"},"path":{"type":"string","pattern":"^docs/retros/[a-z][a-z0-9-]+\\.md$"},"prUrl":{"$ref":"#/$defs/ceremonyPr"},"baseBranch":{"const":"main"},"mergedSha":{"$ref":"#/$defs/ceremonySha"},"postId":{"$ref":"#/$defs/ceremonyText"},"publishedAt":{"$ref":"#/$defs/ceremonyTime"},"factsOnly":{"const":true},"suggestions":{"const":"owner-proposals-only"},"authorization":{"type":"object","additionalProperties":false,"required":["headSha","mergePostId","approval"],"properties":{"headSha":{"$ref":"#/$defs/ceremonySha"},"mergePostId":{"$ref":"#/$defs/ceremonyText"},"approval":{"$ref":"#/$defs/ceremonyApprovalProvenance"}}}}},
    "ceremonyLegacyApproval": {"type": "object", "additionalProperties": false, "required": ["kind", "proposalId"], "properties": {"kind": {"const": "legacy-approval"}, "proposalId": {"$ref": "#/$defs/ceremonyId"}}},
    "ceremonyLegacyImplementation": {"type": "object", "additionalProperties": false, "required": ["kind", "outcomes"], "properties": {"kind": {"const": "legacy-implementation"}, "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["outcomeId", "seatId", "prUrl"], "properties": {"outcomeId": {"$ref": "#/$defs/ceremonyId"}, "seatId": {"$ref": "#/$defs/ceremonyId"}, "prUrl": {"$ref": "#/$defs/ceremonyPr"}}}}, "unmerged": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["outcomeId", "seatId"], "properties": {"outcomeId": {"$ref": "#/$defs/ceremonyId"}, "seatId": {"$ref": "#/$defs/ceremonyId"}}}}}},
    "ceremonyRevertedRelease": {"type": "object", "additionalProperties": false, "required": ["kind", "prUrl", "mergedSha", "revertPrUrl"], "properties": {"kind": {"const": "release-reverted"}, "prUrl": {"$ref": "#/$defs/ceremonyPr"}, "mergedSha": {"$ref": "#/$defs/ceremonySha"}, "revertPrUrl": {"$ref": "#/$defs/ceremonyPr"}}},
    "ceremonyLegacyClosure": {"type": "object", "additionalProperties": false, "required": ["kind", "integration"], "properties": {"kind": {"const": "legacy-migration"}, "integration": {"enum": ["none", "merged", "reverted"]}, "prUrl": {"$ref": "#/$defs/ceremonyPr"}, "mergedSha": {"$ref": "#/$defs/ceremonySha"}, "revertPrUrl": {"$ref": "#/$defs/ceremonyPr"}}},
    "ceremonyEntry": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt"], "properties": {"stage": {"enum": ["planning", "proposal"]}, "enteredAt": {"anyOf": [{"$ref": "#/$defs/ceremonyTime"}, {"type": "null"}]}}}, {"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt", "evidence"], "properties": {"stage": {"const": "implement"}, "enteredAt": {"anyOf": [{"$ref": "#/$defs/ceremonyTime"}, {"type": "null"}]}, "evidence": {"$ref": "#/$defs/ceremonyApproval"}}}, {"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt", "evidence"], "properties": {"stage": {"const": "implement"}, "enteredAt": {"type": "null"}, "evidence": {"$ref": "#/$defs/ceremonyLegacyApproval"}}}, {"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt", "evidence"], "properties": {"stage": {"const": "release"}, "enteredAt": {"anyOf": [{"$ref": "#/$defs/ceremonyTime"}, {"type": "null"}]}, "evidence": {"$ref": "#/$defs/ceremonyImplementation"}}}, {"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt", "evidence"], "properties": {"stage": {"const": "release"}, "enteredAt": {"type": "null"}, "evidence": {"$ref": "#/$defs/ceremonyLegacyImplementation"}}}, {"type": "object", "additionalProperties": false, "required": ["stage", "enteredAt", "evidence"], "properties": {"stage": {"const": "retro"}, "enteredAt": {"anyOf": [{"$ref": "#/$defs/ceremonyTime"}, {"type": "null"}]}, "evidence": {"$ref": "#/$defs/ceremonyRelease"}}}]},
    "ceremony": {"type": "object", "additionalProperties": false, "required": ["version", "stage", "history"], "properties": {"version": {"const": 1}, "stage": {"enum": ["planning", "proposal", "implement", "release", "retro"]}, "history": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/ceremonyEntry"}}, "migratedAt": {"$ref": "#/$defs/ceremonyTime"}, "closure": {"type": "object", "additionalProperties": false, "required": ["closedAt", "evidence"], "properties": {"closedAt": {"$ref": "#/$defs/ceremonyTime"}, "evidence": {"oneOf": [{"$ref": "#/$defs/ceremonyRetro"}, {"$ref": "#/$defs/ceremonyRevertedRelease"}, {"$ref": "#/$defs/ceremonyLegacyClosure"}]}}}}, "allOf": [{"if": {"properties": {"stage": {"const": "planning"}}}, "then": {"properties": {"history": {"minItems": 1, "maxItems": 1, "prefixItems": [{"properties": {"stage": {"const": "planning"}}}]}}}}, {"if": {"properties": {"stage": {"const": "proposal"}}}, "then": {"properties": {"history": {"minItems": 2, "maxItems": 2, "prefixItems": [{"properties": {"stage": {"const": "planning"}}}, {"properties": {"stage": {"const": "proposal"}}}]}}}}, {"if": {"properties": {"stage": {"const": "implement"}}}, "then": {"properties": {"history": {"minItems": 3, "maxItems": 3, "prefixItems": [{"properties": {"stage": {"const": "planning"}}}, {"properties": {"stage": {"const": "proposal"}}}, {"properties": {"stage": {"const": "implement"}}}]}}}}, {"if": {"properties": {"stage": {"const": "release"}}}, "then": {"properties": {"history": {"minItems": 4, "maxItems": 4, "prefixItems": [{"properties": {"stage": {"const": "planning"}}}, {"properties": {"stage": {"const": "proposal"}}}, {"properties": {"stage": {"const": "implement"}}}, {"properties": {"stage": {"const": "release"}}}]}}}}, {"if": {"properties": {"stage": {"const": "retro"}}}, "then": {"properties": {"history": {"minItems": 5, "maxItems": 5, "prefixItems": [{"properties": {"stage": {"const": "planning"}}}, {"properties": {"stage": {"const": "proposal"}}}, {"properties": {"stage": {"const": "implement"}}}, {"properties": {"stage": {"const": "release"}}}, {"properties": {"stage": {"const": "retro"}}}]}}}}, {"if": {"required": ["closure"], "properties": {"closure": {"properties": {"evidence": {"properties": {"kind": {"enum": ["retro-published"]}}}}}}}, "then": {"properties": {"stage": {"const": "retro"}}}}, {"if": {"required": ["closure"], "properties": {"closure": {"properties": {"evidence": {"properties": {"kind": {"enum": ["release-reverted", "legacy-migration"]}}}}}}}, "then": {"properties": {"stage": {"const": "release"}}}}, {"if": {"required": ["closure"], "properties": {"closure": {"properties": {"evidence": {"properties": {"kind": {"enum": ["legacy-migration"]}}}}}}}, "then": {"required": ["migratedAt"]}}, {"if": {"not": {"required": ["migratedAt"]}}, "then": {"properties": {"history": {"items": {"properties": {"enteredAt": {"$ref": "#/$defs/ceremonyTime"}}}}}}}]},
    "ceremonyAutomaticApproval": {"type":"object","additionalProperties":false,"required":["source","policyRevision","at","target"],"properties":{"source":{"const":"automatic"},"policyRevision":{"type":"integer","minimum":1},"at":{"$ref":"#/$defs/ceremonyTime"},"target":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","goalId","proposalId","proposalDigest"],"properties":{"kind":{"const":"proposal"},"goalId":{"$ref":"#/$defs/ceremonyId"},"proposalId":{"$ref":"#/$defs/ceremonyId"},"proposalDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},{"type":"object","additionalProperties":false,"required":["kind","goalId","prUrl","headSha","checksPassed","reviewApproved","reviewer","reviewedHeadSha"],"properties":{"kind":{"enum":["integration","retro"]},"goalId":{"$ref":"#/$defs/ceremonyId"},"prUrl":{"$ref":"#/$defs/ceremonyPr"},"headSha":{"$ref":"#/$defs/ceremonySha"},"checksPassed":{"const":true},"reviewApproved":{"const":true},"reviewer":{"const":"satori-miyamoto"},"reviewedHeadSha":{"$ref":"#/$defs/ceremonySha"}}}]}}},
    "ceremonyApprovalProvenance": {"oneOf":[{"$ref":"#/$defs/ceremonyHumanApproval"},{"$ref":"#/$defs/ceremonyAutomaticApproval"}]},
    "standingPolicy": {"type":"object","additionalProperties":false,"required":["revisions"],"properties":{"revisions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["revision","enabled","source","at"],"properties":{"revision":{"type":"integer","minimum":1},"enabled":{"type":"boolean"},"source":{"const":"owner-command"},"at":{"type":"string","format":"date-time"}}}}}},
    "backlogTicket": {"type":"object","additionalProperties":false,"required":["id","title","description","value","status","createdAt","updatedAt","createdBySeatId","updatedBySeatId"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},"title":{"type":"string","pattern":"\\S"},"description":{"type":"string","pattern":"\\S"},"value":{"type":"string","pattern":"\\S"},"status":{"enum":["open","planned","done","discarded"]},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"createdBySeatId":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},"updatedBySeatId":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},"dependsOn":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"}},"research":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["url","finding"],"properties":{"url":{"type":"string","pattern":"^https?://","format":"uri"},"finding":{"type":"string","pattern":"\\S"}}}}}},
